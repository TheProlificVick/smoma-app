# Copy this file to application-local.properties (gitignored) and fill in real values.
# Never commit passwords, LDAP binds, or JWT secrets.

spring.datasource.url=jdbc:mysql://localhost:3306/smoma_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=CHANGE_ME

spring.ldap.urls=ldap://YOUR-AD-HOST:389
spring.ldap.base=dc=art,dc=cm
spring.ldap.username=YOUR_AD_BIND_USER
spring.ldap.password=CHANGE_ME

# At least 32 random characters. Generate a new secret for every environment.
jwt.secret=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
jwt.expiration=28800000

server.port=8086
